{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "f1-dash",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-20",
  "observability": { "enabled": true },
  "d1_databases": [{ "binding": "DB", "database_name": "f1-dash", "database_id": "local", "migrations_dir": "drizzle" }]
}
